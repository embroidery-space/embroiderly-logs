{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "embroiderly-logs",
  "compatibility_date": "2026-05-12",

  "main": "src/main.ts",
  "compatibility_flags": ["nodejs_compat"],

  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },

  "vars": {
    "TELEGRAM_CHANNEL_ID": "",
  },
  "secrets": {
    "required": ["TELEGRAM_BOT_TOKEN", "WEBHOOK_SECRET"],
  },
}
